# ============================================================
# Hermclaw .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
*.so
*.dylib

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.ruff_cache/
.pytype/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts
build/
dist/
*.whl
pip-wheel-metadata/
*.manifest
*.spec

# SQLite databases (user state -- generated at runtime)
*.db
*.db-wal
*.db-shm
*.db-journal

# Hermclaw user data (runtime profile data, never commit)
.hermclaw/

# Logs
*.log
logs/

# Node.js (WhatsApp sidecar)
node_modules/
package-lock.json

# WhatsApp auth state
.wa-auth/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Environment / secrets -- NEVER commit these
.env
.env.*
.env.local
.env.production

# Jupyter Notebooks
.ipynb_checkpoints/

# Distribution / packaging
*.tar.gz
*.zip

# Misc
*.bak
*.tmp
*.temp
